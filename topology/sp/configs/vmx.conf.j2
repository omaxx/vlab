system {
    host-name {{ device.name }};
    root-authentication {
        encrypted-password "{{ root_pass }}";
    }
{%- if user_name is defined %}
{%- set key_types = {"ssh-rsa": "ssh-rsa", "ssh-ed25519": "ssh-ed25519", "ssh-dss": "ssh-dsa",
                     "ecdsa-sha2-nistp256": "ssh-ecdsa", "ecdsa-sha2-nistp384": "ssh-ecdsa", "ecdsa-sha2-nistp521": "ssh-ecdsa"} %}
    login {
        user {{ user_name }} {
            class super-user;
            authentication {
                encrypted-password "{{ user_pass }}";
{%- for key in (user_key | default("")).splitlines() if key.strip() %}
                {{ key_types[key.split()[0]] }} "{{ key.strip() }}";
{%- endfor %}
            }
        }
    }
{%- endif %}
    services {
        ssh {
            root-login allow;
        }
    }
}
chassis {
    fpc 0 {
        lite-mode;
    }
}
{#- interface families: ip -> inet, ipv6 -> inet6, iso -> iso, mpls -> mpls; value address or true (family only) #}
interfaces {
{%- for name, ifc in interfaces.items() %}
    {{ name }} {
{%- if ifc.description is defined %}
        description "{{ ifc.description }}";
{%- endif %}
        unit 0 {
{%- for key, family in [("ip", "inet"), ("ipv6", "inet6"), ("iso", "iso"), ("mpls", "mpls")] %}
{%- set value = ifc[key] | default(false) %}
{%- if value is string %}
            family {{ family }} {
                address {{ value }};
            }
{%- elif value is sameas true %}
            family {{ family }};
{%- endif %}
{%- endfor %}
        }
    }
{%- endfor %}
}
{%- if static_routes is defined and static_routes %}
routing-options {
    static {
{%- for prefix, next_hop in static_routes.items() %}
        route {{ prefix }} next-hop {{ next_hop }};
{%- endfor %}
    }
}
{%- endif %}
protocols {
    lldp {
        interface all;
        interface fxp0 {
            disable;
        }
    }
{%- set mpls_ifs = interfaces.items() | selectattr("1.mpls", "sameas", true) | map(attribute="0") | list %}
{%- if mpls_ifs %}
    mpls {
{%- for name in mpls_ifs %}
        interface {{ name }};
{%- endfor %}
    }
{%- endif %}
}
